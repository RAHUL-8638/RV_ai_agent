rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Health / Connection check
    match /test/connection {
      allow read: if true;
    }

    // Single owner verification via database document
    function isOwner() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'OWNER';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().id == userId &&
        incoming().role == 'USER' && // Prevent self-elevation to OWNER
        incoming().username is string && incoming().username.size() >= 3 && incoming().username.size() <= 32;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().role == existing().role) || isOwner()
      );
      allow delete: if isOwner();
    }

    // Articles Collection
    match /articles/{articleId} {
      allow read: if isValidId(articleId);
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().content is string && incoming().content.size() <= 50000;
      allow update, delete: if isSignedIn() && (
        (existing().authorId == request.auth.uid) || isOwner()
      );
    }

    // Videos Collection
    match /videos/{videoId} {
      allow read: if isValidId(videoId) && (resource.data.isPublic == true || (isSignedIn() && (resource.data.userId == request.auth.uid || isOwner())));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        (existing().userId == request.auth.uid) || isOwner()
      );
    }

    // Documents Collection
    match /documents/{documentId} {
      allow read: if isValidId(documentId);
      allow create: if isSignedIn() && incoming().uploaderId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        (existing().uploaderId == request.auth.uid) || isOwner()
      );
    }

    // Community Posts Collection
    match /posts/{postId} {
      allow read: if isValidId(postId);
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 250;
      allow update, delete: if isSignedIn() && (
        (existing().authorId == request.auth.uid) || isOwner()
      );
    }
  }
}
